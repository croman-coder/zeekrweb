# Directus 11 — SQLite. Copiar valores reales en Coolify (Environment Variables), nunca commitear secretos.
# Se sirve bajo https://zeekrlife.com.py/cms (nginx de zeekr-web quita el prefijo /cms); ver README.md.
PUBLIC_URL=https://zeekrlife.com.py/cms
KEY=<uuid aleatorio: python3 -c "import uuid;print(uuid.uuid4())">
SECRET=<openssl rand -hex 32>
DB_CLIENT=sqlite3
DB_FILENAME=/directus/database/data.db
ADMIN_EMAIL=croman@santarosa.com.py
ADMIN_PASSWORD=<contraseña inicial fuerte; cambiar al primer login>
DEFAULT_LANGUAGE=es-ES
TELEMETRY=false
RATE_LIMITER_ENABLED=true
RATE_LIMITER_POINTS=50
RATE_LIMITER_DURATION=1
CORS_ENABLED=true
CORS_ORIGIN=https://zeekrlife.com.py
PASSWORD_RESET_URL_ALLOW_LIST=https://zeekrlife.com.py/cms/admin/reset-password
USER_INVITE_URL_ALLOW_LIST=https://zeekrlife.com.py/cms/admin/accept-invite
USER_REGISTER_URL_ALLOW_LIST=
# EMAIL_*: todavía sin cargar en producción (falta la contraseña de aplicación de Google Workspace)
EMAIL_FROM=<casilla Google Workspace, p. ej. marketing@santarosa.com.py>
EMAIL_TRANSPORT=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=<la misma casilla>
EMAIL_SMTP_PASSWORD=<contraseña de aplicación de Google Workspace (16 letras)>
FILES_MAX_UPLOAD_SIZE=25mb
FLOWS_ENV_ALLOW_LIST=BUILDER_TOKEN
BUILDER_TOKEN=<openssl rand -hex 32; el mismo valor va al builder>
ASSETS_TRANSFORM_MAX_CONCURRENT=2
